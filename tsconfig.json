{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "strict": false,
    "skipLibCheck": true
  },
  "include": ["server/**/*.js", "shared/**/*.js", "scripts/**/*.js", "tests/**/*.js", "app.js", "vite.config.js"]
}
