# App runtime
PORT=8787
CORS_ORIGIN=http://localhost:4173

# Persistence mode
# Leave AWS vars unset for local JSON mode
AWS_REGION=ap-south-1
DDB_APP_TABLE=

# Upload storage mode
S3_UPLOAD_BUCKET=
S3_UPLOAD_PREFIX=uploads

# Weather mode: open-meteo (default) or fallback
WEATHER_PROVIDER_MODE=open-meteo

# Optional custom local DB path
# LOCAL_DB_PATH=/absolute/path/to/local-db.json
# LOCAL_UPLOADS_DIR=/absolute/path/to/uploads
